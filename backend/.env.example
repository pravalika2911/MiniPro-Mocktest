PORT=5000
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=production
ADMIN_EMAIL=your-admin@gmail.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Gmail SMTP: use a Google App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-full-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Sentinel Protocol <your-full-gmail-address@gmail.com>
CLIENT_URL=https://your-public-frontend-domain.example
